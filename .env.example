# Desarrollo local (.env.local). Supabase, Project Settings, API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "Publishable key" (sb_publishable_...) o la "anon key" antigua
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# En Docker/Unraid se usan SUPABASE_URL y SUPABASE_PUBLISHABLE_KEY (mismos valores) en la plantilla del contenedor.
